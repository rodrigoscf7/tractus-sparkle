# Copie para .env.local e preencha. Nunca versione valores reais.

# Projeto Supabase (Project Settings > API)
SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""

# Mesmas credenciais expostas ao bundle do cliente (injetadas em build-time pelo Vite)
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Web Push — a mesma chave pública gerada por "npx web-push generate-vapid-keys",
# também configurada como segredo VAPID_PUBLIC_KEY nas Edge Functions.
VITE_VAPID_PUBLIC_KEY=""

# Somente servidor — nunca prefixar com VITE_
SUPABASE_SERVICE_ROLE_KEY=""
# Token da integração de webhook da Hubla (Integrações → Webhook → Autenticação).
HUBLA_WEBHOOK_TOKEN=""

# Meta Pixel das páginas do funil (quiz, relatório, boas-vindas). Público por natureza;
# vazio = sem rastreamento. No Railway precisa estar disponível no build.
VITE_META_PIXEL_ID=""

# Vídeo do topo do relatório (/dna-viral/<token>): arquivo .mp4/.webm ou link do
# YouTube/Vimeo/Bunny. Vazio = placeholder "Em breve". Poster opcional (imagem 9:16).
VITE_VIDEO_DIAGNOSTICO_URL=""
VITE_VIDEO_DIAGNOSTICO_POSTER=""

# Secrets das Edge Functions (supabase secrets set ...), NÃO deste arquivo:
#   RESEND_API_KEY, EMAIL_REMETENTE ("prevIA <contato@seudominio>"), SITE_URL ("https://seudominio")
